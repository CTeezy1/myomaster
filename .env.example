# Supabase (public — safe for browser bundles)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role (server-only — never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Section confirmation passwords (server-only — never expose to the client)
# Local development values:
# SECTION_PASSWORD_TESTING=Testing
# SECTION_PASSWORD_KINESIOLOGY_1=Cowboys1
# SECTION_PASSWORD_KINESIOLOGY_2=Cowboys2
# SECTION_PASSWORD_MOVEMENT_ANATOMY_1=Panda1
# SECTION_PASSWORD_MOVEMENT_ANATOMY_2=Panda2
SECTION_PASSWORD_TESTING=your-section-password
SECTION_PASSWORD_KINESIOLOGY_1=your-section-password
SECTION_PASSWORD_KINESIOLOGY_2=your-section-password
SECTION_PASSWORD_MOVEMENT_ANATOMY_1=your-section-password
SECTION_PASSWORD_MOVEMENT_ANATOMY_2=your-section-password

# Instructor dashboard allowlist (server-only — never expose to the client)
# Comma-separated auth user UUIDs. Username and section are not authorization factors.
# Example: INSTRUCTOR_USER_IDS=00000000-0000-0000-0000-000000000000
INSTRUCTOR_USER_IDS=
